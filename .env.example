# Tech Intelligence Engine - Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tech_intel

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SEARCH / INDEXING
# =============================================================================
# Elasticsearch / OpenSearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Vector Database (Qdrant / Weaviate / Pinecone)
VECTOR_DB_TYPE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# WEaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# Embedding model configuration
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# Reranker model
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_BATCH_SIZE=16

# =============================================================================
# EXTERNAL API KEYS (Data Sources)
# =============================================================================
# GitHub API (for repos, releases, commits, issues)
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_API_URL=https://api.github.com

# Hugging Face Hub (models, datasets, papers, spaces)
HF_TOKEN=your-huggingface-token
HF_API_URL=https://huggingface.co/api

# ArXiv API (papers) - no key required, but polite to identify
ARXIV_API_URL=http://export.arxiv.org/api/query
ARXIV_USER_AGENT=tech-intelligence-engine/0.1

# Semantic Scholar (papers, citations, authors)
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1

# Crossref (DOI metadata)
CROSSREF_API_URL=https://api.crossref.org
CROSSREF_USER_AGENT=tech-intelligence-engine/0.1 (mailto:your-email@example.com)

# =============================================================================
# LLM PROVIDERS (for agentic research, enrichment, reranking)
# =============================================================================
# OpenAI
OPENAI_API_KEY=your-openai-key
OPENAI_ORG_ID=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Google / Vertex AI
GOOGLE_API_KEY=your-google-key
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=

# OpenRouter (multi-provider)
OPENROUTER_API_KEY=your-openrouter-key

# Local LLM (Ollama, vLLM, TGI)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Metrics (Prometheus)
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# INGESTION PIPELINE
# =============================================================================
# Scheduler
INGESTION_SCHEDULE_ENABLED=true
INGESTION_INTERVAL_MINUTES=60
INGESTION_BATCH_SIZE=100
INGESTION_MAX_CONCURRENT=4

# Rate limiting per source (requests per minute)
RATE_LIMIT_GITHUB=5000
RATE_LIMIT_HF=1000
RATE_LIMIT_ARXIV=30
RATE_LIMIT_SEMANTIC_SCHOLAR=100
RATE_LIMIT_CROSSREF=50

# =============================================================================
# AUTHENTICATION (Future)
# =============================================================================
# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# OAuth providers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_SEARCH=true
FEATURE_DISCOVERY=false
FEATURE_RESEARCH_AGENTS=false
FEATURE_PERSONALIZATION=false
FEATURE_ALERTS=false
FEATURE_CHANGE_DETECTION=false